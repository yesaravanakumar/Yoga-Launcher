<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device-to-device transfer: settings only. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="yoga.xml" />
        <include domain="root" path="app_webview/Default/Local Storage" />
        <exclude domain="root" path="app_webview/Default/Cache" />
        <exclude domain="root" path="app_webview/Default/Code Cache" />
        <exclude domain="root" path="app_webview/Default/GPUCache" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="yoga.xml" />
        <include domain="root" path="app_webview/Default/Local Storage" />
    </device-transfer>
</data-extraction-rules>
